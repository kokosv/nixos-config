xkb_symbols "bg_phonetic_dvorak" {
    include "us(dvorak)"

    name[Group1] = "Bulgarian Phonetic Dvorak";

    // Top row (inherited: AD01='" AD02=,< AD03=.> unchanged)
    key <AD04> { [ Cyrillic_pe,       Cyrillic_PE       ] }; // p → п
    key <AD05> { [ Cyrillic_hardsign, Cyrillic_HARDSIGN ] }; // y → ъ
    key <AD06> { [ Cyrillic_ef,       Cyrillic_EF       ] }; // f → ф
    key <AD07> { [ Cyrillic_ghe,      Cyrillic_GHE      ] }; // g → г
    key <AD08> { [ Cyrillic_tse,      Cyrillic_TSE      ] }; // c → ц
    key <AD09> { [ Cyrillic_er,       Cyrillic_ER       ] }; // r → р
    key <AD10> { [ Cyrillic_el,       Cyrillic_EL       ] }; // l → л
    key <AD11> { [ Cyrillic_sha,      Cyrillic_SHA      ] }; // [ → ш
    key <AD12> { [ Cyrillic_shcha,    Cyrillic_SHCHA    ] }; // ] → щ

    // Home row
    key <AC01> { [ Cyrillic_a,        Cyrillic_A        ] }; // a → а
    key <AC02> { [ Cyrillic_o,        Cyrillic_O        ] }; // o → о
    key <AC03> { [ Cyrillic_ie,       Cyrillic_IE       ] }; // e → е
    key <AC04> { [ Cyrillic_u,        Cyrillic_U        ] }; // u → у
    key <AC05> { [ Cyrillic_i,        Cyrillic_I        ] }; // i → и
    key <AC06> { [ Cyrillic_de,       Cyrillic_DE       ] }; // d → д
    key <AC07> { [ Cyrillic_ha,       Cyrillic_HA       ] }; // h → х
    key <AC08> { [ Cyrillic_te,       Cyrillic_TE       ] }; // t → т
    key <AC09> { [ Cyrillic_en,       Cyrillic_EN       ] }; // n → н
    key <AC10> { [ Cyrillic_es,       Cyrillic_ES       ] }; // s → с
    // AC11 (physical ', Dvorak -/_) inherited unchanged

    // Bottom row (inherited: AB01=;: unchanged)
    key <AB02> { [ Cyrillic_ya,       Cyrillic_YA       ] }; // q → я
    key <AB03> { [ U0439,             U0419             ] }; // j → й/Й
    key <AB04> { [ Cyrillic_ka,       Cyrillic_KA       ] }; // k → к
    key <AB05> { [ Cyrillic_softsign, U045D             ] }; // x → ь/ѝ
    key <AB06> { [ Cyrillic_be,       Cyrillic_BE       ] }; // b → б
    key <AB07> { [ Cyrillic_em,       Cyrillic_EM       ] }; // m → м
    key <AB08> { [ Cyrillic_zhe,      Cyrillic_ZHE      ] }; // w → ж
    key <AB09> { [ Cyrillic_ve,       Cyrillic_VE       ] }; // v → в
    key <AB10> { [ Cyrillic_ze,       Cyrillic_ZE       ] }; // z → з

    // Special
    key <BKSL> { [ Cyrillic_yu,       Cyrillic_YU       ] }; // \ → ю
    key <TLDE> { [ Cyrillic_che,      Cyrillic_CHE      ] }; // ` → ч
};
